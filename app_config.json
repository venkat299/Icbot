{
  "llm": {
    "routes": {
      "qwen3-4b-local": {
        "provider": "openai",
        "model": "qwen/qwen3-4b-2507",
        "base_url": "http://localhost:1234/v1",
        "endpoint": "/v1/chat/completions",
        "timeout_seconds": 60,
        "max_retries": 2,
        "api_key_env": "LLM_API_KEY",
        "requires_api_key": false,
        "enforce_json": false
      },
      "phi-4": {
        "provider": "openai",
        "model": "microsoft/phi-4",
        "base_url": "http://localhost:1234/v1",
        "endpoint": "/v1/chat/completions",
        "timeout_seconds": 120,
        "max_retries": 2,
        "api_key_env": "LLM_API_KEY",
        "requires_api_key": false,
        "enforce_json": false
      },
      "qwen3-human": {
        "provider": "openai",
        "model": "qwen3-deckard-large-almost-human-6b-iii-150-i1",
        "base_url": "http://localhost:1234/v1",
        "endpoint": "/v1/chat/completions",
        "timeout_seconds": 60,
        "max_retries": 2,
        "api_key_env": "LLM_API_KEY",
        "requires_api_key": false,
        "enforce_json": false
      }
    },
    
    "registry": {
      "rubric.generate": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.rubric.RubricModel"
      },
      "competency.generate": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.competency.CompetencyPlan"
      },
      "warmup.opening": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.warmup.WarmupTurn"
      },
      "candidate.reply": {
        "route": "qwen3-4b-local",
        "schema_path": "candidate_service.schemas.CandidateReply"
      },
      "evaluation.score": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.evaluation.EvaluationVerdict"
      },
      "evaluation.criterion": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.criterion.EvaluationResult"
      },
      "criterion.followup": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.criterion_followup.CriterionFollowUp"
      },
      "wrapup.summary": {
        "route": "qwen3-4b-local",
        "schema_path": "icbot_backend.schemas.wrapup_summary.WrapupSummary"
      },
      "wrapup.closing": {
        "route": "qwen3-4b-local",
        "schema_path": "icbot_backend.schemas.wrapup_summary.WrapupClosing"
      },
      "styles.directive": {
        "route": "qwen3-4b-local",
        "schema_path": "icbot_backend.styles.base.DirectiveSchema"
      }
    }
  },
  "candidate": {
    "default_level": "L3",
    "post_processing_prompt_id": "post_processing",
    "generation_notes_prompt_id": "generation_notes",
    "response_format_prompt_id": "response_format",
    "levels": {
      "L0": { "label": "Level 0 - Novice", "prompt_id": "L0", "index": 0 },
      "L1": { "label": "Level 1 - Beginner", "prompt_id": "L1", "index": 1 },
      "L2": { "label": "Level 2 - Junior", "prompt_id": "L2", "index": 2 },
      "L3": { "label": "Level 3 - Mid", "prompt_id": "L3", "index": 3 },
      "L4": { "label": "Level 4 - Senior", "prompt_id": "L4", "index": 4 },
      "L5": { "label": "Level 5 - Principal", "prompt_id": "L5", "index": 5 }
    }
  },
  "flow": {
    "stages": [
      "warmup",
      "competency",
      "wrapup"
    ],
    "competency": {
      "min": 3,
      "max": 3
    },
    "warmup": {
      "max_turns": 3,
      "ready_threshold": 0.1
    }
  },
  "rubric": {
    "max_criteria_per_competency": 3
  },
  "evaluation": {
    "routes": {
      "scoring": "phi-4"
    },
    "schema_registry": {
      "final_report": "icbot_backend.schemas.evaluation.EvaluationVerdict"
    },
    "weights": {
      "competency-1": 0.34,
      "competency-2": 0.33,
      "competency-3": 0.33
    },
    "criterion_flow": {
      "confidence_threshold": 0.7,
      "min_attempts": 2,
      "max_attempts": 2
    }
  },
  "ui": {
    "default_view_mode": "interviewer",
    "tts_enabled": false,
    "auto_candidate_reply": false
  }
}
