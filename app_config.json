{
  "llm": {
    "routes": {
      "qwen3-4b-local": {
        "provider": "openai",
        "model": "qwen/qwen3-4b-2507",
        "base_url": "http://localhost:1234/v1",
        "endpoint": "/v1/chat/completions",
        "timeout_seconds": 60,
        "max_retries": 2,
        "api_key_env": "LLM_API_KEY",
        "requires_api_key": false,
        "enforce_json": false
      },
      "phi-4": {
        "provider": "openai",
        "model": "microsoft/phi-4",
        "base_url": "http://localhost:1234/v1",
        "endpoint": "/v1/chat/completions",
        "timeout_seconds": 60,
        "max_retries": 2,
        "api_key_env": "LLM_API_KEY",
        "requires_api_key": false,
        "enforce_json": false
      },
      "qwen3-human": {
        "provider": "openai",
        "model": "qwen3-deckard-large-almost-human-6b-iii-150-i1",
        "base_url": "http://localhost:1234/v1",
        "endpoint": "/v1/chat/completions",
        "timeout_seconds": 60,
        "max_retries": 2,
        "api_key_env": "LLM_API_KEY",
        "requires_api_key": false,
        "enforce_json": false
      }
    },
    
    "registry": {
      "rubric.generate": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.rubric.RubricModel"
      },
      "competency.generate": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.competency.CompetencyPlan"
      },
      "warmup.opening": {
        "route": "qwen3-human",
        "schema_path": "icbot_backend.schemas.warmup.WarmupTurn"
      },
      "candidate.reply": {
        "route": "qwen3-human",
        "schema_path": "candidate_service.schemas.CandidateReply"
      },
      "evaluation.score": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.evaluation.EvaluationVerdict"
      },
      "evaluation.criterion": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.criterion.EvaluationResult"
      },
      "wrapup.summary": {
        "route": "phi-4",
        "schema_path": "icbot_backend.schemas.wrapup_summary.WrapupSummary"
      },
      "styles.directive": {
        "route": "phi-4",
        "schema_path": "icbot_backend.styles.base.DirectiveSchema"
      }
    }
  },
  "flow": {
    "stages": [
      "warmup",
      "competency",
      "wrapup"
    ],
    "competency": {
      "min": 3,
      "max": 3
    },
    "warmup": {
      "max_turns": 3,
      "ready_threshold": 0.75
    }
  },
  "rubric": {
    "max_criteria_per_competency": 3
  },
  "evaluation": {
    "routes": {
      "scoring": "qwen3-4b-local"
    },
    "schema_registry": {
      "final_report": "icbot_backend.schemas.evaluation.EvaluationVerdict"
    },
    "weights": {
      "competency-1": 0.34,
      "competency-2": 0.33,
      "competency-3": 0.33
    }
  },
  "ui": {
    "default_view_mode": "interviewer",
    "tts_enabled": false,
    "auto_candidate_reply": true
  }
}
